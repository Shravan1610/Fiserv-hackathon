GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_THINKING_LEVEL=MINIMAL
# Optional: set to "true" only on networks where Gemini SSL fails.
# GEMINI_INSECURE_SSL=false

# Local dev without Postgres: USE_SQLITE=true
USE_SQLITE=false

# Postgres — set DATABASE_URL OR the individual PG* vars
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/expenses
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=expenses
